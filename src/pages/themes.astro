---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getConfig, listThemes} from '../lib/data';

const themes = await listThemes();
const config = (await getConfig()).data?.config ?? null;
---

<BaseLayout
	title={config?.seo?.title ?? 'themes'}
	description={config?.seo?.description ?? ''}
>
	<main class="mx-auto max-w-5xl px-6 pt-2 pb-10">
		<h1 class="mb-8 text-4xl font-semibold  text-center  tracking-tight">themes</h1>
		<ul class="grid list-none gap-6 p-0 sm:grid-cols-2">
			{themes.map((theme) => (
				<li>
					<a href={`/themes/${theme._sys.filename}/`} class="group block overflow-hidden rounded-xl border bg-card shadow-sm transition-shadow hover:shadow-md">
						{theme.previewImage && (
							<img width={720} height={360} src={theme.previewImage} alt={theme.title ?? ''} class="aspect-video w-full object-cover" />
						)}
						<div class="p-6">
							<h2 class="font-semibold group-hover:underline">{theme.title}</h2>
						</div>
					</a>
				</li>
			))}
		</ul>
	</main>
</BaseLayout>
