---
import SmallWorkLayout from '../../layouts/SmallWorkLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import SmallWorkBody from '../../components/islands/SmallWorkBody.astro';
import { getSmallWork, listSmallWorks } from '../../lib/data';
import { islands } from '../../lib/islands';

export async function getStaticPaths() {
	const smallWorks = await listSmallWorks();
	return smallWorks.map((node) => ({ params: { slug: node._sys.filename } }));
}

const slug = (Astro.params.slug ?? '').toString();
const smallWork = await getSmallWork(slug);
const data = smallWork.data?.smallWork;
if (!data) return new Response('Not Found', { status: 404 });

const layoutProps = {
	title: data.title ?? '',
	description: data.description ?? '',
	category: data.category?.title ?? 'misc',
	showDate: data.showDate ? new Date(data.showDate) : new Date(),
	bannerImage: data.bannerImage ?? null,
};
---

<SmallWorkLayout back={data.theme ? ('themes/' + data.theme._sys.filename) : ( data.project ? (data.project.category._sys.filename + data.project._sys.filename) : 'themes/misc')}  {...layoutProps}>
	<TinaIsland name="smallWork" wrapper={islands.smallWork.wrapper} params={{ slug }} primary>
		<SmallWorkBody data={data} />
	</TinaIsland>
</SmallWorkLayout>
