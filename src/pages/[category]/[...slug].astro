---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import ProjectBody from '../../components/islands/ProjectBody.astro';
import { getProject, listProjects } from '../../lib/data';
import { islands } from '../../lib/islands';

export async function getStaticPaths() {
	const projects = await listProjects();
	const filteredProjects = projects.filter((node) => node.category);
	return filteredProjects.map((node) => ({ params: { category: node.category._sys.filename, slug: node._sys.filename } }));
}

const slug = (Astro.params.slug ?? '').toString();
const project = await getProject(slug);
const data = project.data?.project;
if (!data) return new Response('Not Found', { status: 404 });
const category = (Astro.params.category);

const layoutProps = {
	title: data.title ?? '',
	description: data.description ?? '',
	category: data.category ? data.category.title : (category ? category : 'misc'),
	showDate: data.showDate ? new Date(data.showDate) : new Date(),
	bannerImage: data.bannerImage ?? null,
};
---

<ProjectLayout back={layoutProps.category} {...layoutProps}>
	<TinaIsland name="project" wrapper={islands.project.wrapper} params={{ slug }} primary>
		<ProjectBody data={data} />
	</TinaIsland>
</SmallWorkLayout>
