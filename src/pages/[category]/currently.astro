---
import CategoryLayout from '../../layouts/ProjectLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import CategoryBody from '../../components/islands/CategoryBody.astro';
import { getCategory, listProjects, listCategories } from '../../lib/data';
import { islands } from '../../lib/islands';

export async function getStaticPaths() {
	const categories = await listCategories();
	const filteredCategories = categories.filter((category) => (category.currentOnly === false));
	return filteredCategories.map((node) => ({ params: { category: node._sys.filename, when: 'currently' }}));
}

const slug = (Astro.params.category ?? '').toString();
const category = await getCategory(slug);
const data = category.data?.category;
if (!data) return new Response('Not Found', { status: 404 });

const allProjects = await listProjects();
const filteredProjects = allProjects.filter((project) => ( project.category._sys.filename === data._sys.filename));
const projects = (data.currentOnly ? filteredProjects :
	filteredProjects.filter((project) => (project.when === 'currently')));

const layoutProps = {
	title: data.title ?? '',
	description: data.description ?? '',
};
---

<CategoryLayout back={data._sys.filename} {...layoutProps}>
	<TinaIsland name="category" wrapper={islands.category.wrapper} params={{ slug }} primary>
		<CategoryBody data={data} projects={projects} when="currently" />
	</TinaIsland>
</CategoryLayout>