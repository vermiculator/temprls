---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---
<BaseLayout title="Lost in space (404)" description="This page drifted out of orbit.">
	<section class="relative flex min-h-[70vh] items-center justify-center overflow-hidden px-6 text-center">
		<div class="relative flex flex-col items-center">
			<p class="text-sm font-medium tracking-widest text-primary uppercase">Error 404</p>
			<h1 class="mt-2 text-4xl font-semibold tracking-tight lg:text-5xl">Page not found</h1>
			<p class="mx-auto mt-4 max-w-md text-muted-foreground">Sorry about that.</p>
			<Button href="/" class="mt-8">Back to home</Button>
		</div>
	</section>
</BaseLayout>
