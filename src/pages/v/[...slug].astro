---
import VignetteLayout from '../../layouts/VignetteLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import VignetteBody from '../../components/islands/VignetteBody.astro';
import { getVignette, listVignettes } from '../../lib/data';
import { islands } from '../../lib/islands';

export async function getStaticPaths() {
	const vignettes = await listVignettes();
	return vignettes.map((node) => ({ params: { slug: node._sys.filename } }));
}

const slug = (Astro.params.slug ?? '').toString();
const vignette = await getVignette(slug);
const data = vignette.data?.vignette;
if (!data) return new Response('Not Found', { status: 404 });

const layoutProps = {
	theme: data.theme ?? 'misc',
	image: data.image ?? null,
	content: data.content ?? null,
};
---


<VignetteLayout back={'themes/' + data.theme._sys.filename} {...layoutProps}>
	<TinaIsland name="vignette" wrapper={islands.vignette.wrapper} params={{ slug }} primary>
		<VignetteBody data={data} />
	</TinaIsland>
</VignetteLayout>
