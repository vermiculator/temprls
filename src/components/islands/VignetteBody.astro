---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsVignette } from '../../lib/data';

interface Props {
	data?: CmsVignette | null;
}

const { data } = Astro.props;
---
{data && (
	data.image ? (
	<div data-tina-field={tinaField(data, 'image')} class="mx-auto max-w-4xl px-6">
		<img width={1020} height={510} src={data.image} alt="" class="w-full rounded-2xl border shadow-lg" />
	</div>
	) 
	:
	( data.content && (
		<div class="mx-auto max-w-3xl px-6 pt-2 pb-10">
			<div data-tina-field={tinaField(data, 'content')} class="prose prose-lg max-w-none">
				<TinaMarkdown content={data.content} />
			</div>
		</div>
		)
	)
	)
}