---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsCategory } from '../../lib/data';
import type { CmsProject } from '../../lib/data';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
	data?: CmsCategory | null;
	projects?: CmsProject[] | null;
	when?: string | null;
}

const { data, projects, when } = Astro.props;
---

{data && (
	<div class="mx-auto max-w-3xl px-6 pt-2 pb-10">
		<div class="mb-8 text-center">
			{data.title && <h1 data-tina-field={tinaField(data, 'title')} class="mt-2 text-4xl font-semibold tracking-tight lg:text-5xl">{data.title}</h1>}
		</div>
		{data.body && (
			<div data-tina-field={tinaField(data, 'body')} class="prose prose-lg max-w-none">
				<TinaMarkdown content={data.body} />
			</div>
		)}		
		{projects && (
			<div class="max-w-none mx-auto px-6 pt-2 pb-10">
				<ul class="grid list-none gap-2 p-0 sm:grid-cols-2">

					{!data.currentOnly && when !== 'past' &&
						<div class="p-4">
								<Button href={`/${data._sys.filename}/past`} size="lg" variant="ghost" class="rounded-xl px-5 text-base">
									<Icon name="square-arrow-left" class="size-4" />
									<span class="text-nowrap">past</span>
								</Button>
						</div>
					}

					{projects.map((project) => (
						<li>
							<a href={`/${data._sys.filename}/${project._sys.filename}/`} class="group block overflow-hidden rounded-xl border bg-card shadow-sm transition-shadow hover:shadow-md">
								<div class="p-4">
									<h2 class="font-semibold group-hover:underline">{project.previewTitle ? project.previewTitle : project.title}</h2>
								</div>
							</a>
						</li>
					))}
					

					{!data.currentOnly && when === 'past' &&
						<div class="p-4">
								<Button href={`/${data._sys.filename}/currently`} size="lg" variant="ghost" class="rounded-xl px-5 text-base">
									<Icon name="square-arrow-right" class="size-4" />
									<span class="text-nowrap">currently</span>
								</Button>
						</div>
					}

				</ul>
			</div>
		)}
	</div>
)}
