---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsTheme } from '../../lib/data';
import type { CmsProject } from '../../lib/data';
import type { CmsSmallWork } from '../../lib/data';
import type { CmsVignette } from '../../lib/data';

interface Props {
	data?: CmsTheme | null;
	projects?: CmsProject[] | null;
	smallWorks?: CmsSmallWork[] | null;
	vignettes?: CmsVignette[] | null;
}

const { data, projects, smallWorks, vignettes } = Astro.props;
---
{data?.bannerImage && (
	<div data-tina-field={tinaField(data, 'bannerImage')} class="mx-auto max-w-4xl px-6">
		<img width={1020} height={510} src={data.bannerImage} alt="" class="w-full rounded-2xl border shadow-lg" />
	</div>
)}
{data && (
	<div class="mx-auto max-w-3xl px-6 pt-2 pb-10">
		<div class="mb-8 text-center">
			{data.title && <h1 data-tina-field={tinaField(data, 'title')} class="mt-2 text-4xl font-semibold tracking-tight lg:text-5xl">{data.title}</h1>}
		</div>
		{data.body && (
			<div data-tina-field={tinaField(data, 'body')} class="prose prose-lg max-w-none">
				<TinaMarkdown content={data.body} />
			</div>
		)}	
		{projects && (
			<div class="max-w-none mx-auto px-6 pt-2 pb-10">
				<ul class="grid list-none gap-2 p-0 sm:grid-cols-2">
					{projects.map((project) => (
						<li>
							<a href={`/i/${project._sys.filename}/`} class="group block overflow-hidden rounded-xl border bg-card shadow-sm transition-shadow hover:shadow-md">
								{project.previewImage && (
									<img width={360} height={180} src={project.previewImage} alt={project.title ?? ''} class="aspect-video w-full object-cover" />
								)}
								<div class="p-4">
									<h2 class="font-semibold group-hover:underline">{project.title}</h2>
								</div>
							</a>
						</li>
					))}
				</ul>
			</div>
		)}			
		{smallWorks && (
			<div class="max-w-none mx-auto px-6 pt-2 pb-10">
				<ul class="grid list-none gap-2 p-0 sm:grid-cols-2">
					{smallWorks.map((smallWork) => (
						<li>
							<a href={`/i/${smallWork._sys.filename}/`} class="group block overflow-hidden rounded-xl border bg-card shadow-sm transition-shadow hover:shadow-md">
								{smallWork.previewImage && (
									<img width={360} height={180} src={smallWork.previewImage} alt={smallWork.title ?? ''} class="aspect-video w-full object-cover" />
								)}
								<div class="p-4">
									<h2 class="font-semibold group-hover:underline">{smallWork.title}</h2>
								</div>
							</a>
						</li>
					))}
				</ul>
			</div>
		)}	
		{vignettes && (
			<div class="max-w-none mx-auto px-6 py-6">
				<ul class="grid list-none gap-2 p-0 sm:grid-cols-6">
					{vignettes.map((vignette) => (
						<li>
							<a href={`/v/${vignette._sys.filename}/`} class="group block overflow-hidden border bg-card shadow-sm transition-shadow hover:shadow-md">
								{vignette.previewImage && (
									<img width={180} height={90} src={vignette.previewImage} alt={vignette.altText ?? ''} class="aspect-video w-full object-cover" />
								)}
							</a>
						</li>
					))}
				</ul>
			</div>
		)}
	</div>
)}
